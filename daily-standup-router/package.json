{
  "name": "daily-standup-router",
  "version": "1.0.0",
  "description": "Complexity-aware daily standup summarizer with model tier routing via OpenRouter",
  "type": "module",
  "scripts": {
    "start": "node --env-file .env src/index.ts",
    "start:live": "MOCK=0 node --env-file .env --experimental-transform-types src/index.ts",
    "dev": "node --env-file .env --experimental-transform-types --watch src/index.ts"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.5.1",
    "@types/node": "^24.10.12",
    "fastify": "^5.7.4",
    "zod": "^3.24.0"
  }
}
